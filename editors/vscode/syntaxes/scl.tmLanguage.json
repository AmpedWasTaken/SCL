{
  "name": "SCL",
  "scopeName": "source.scl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "name": "keyword.control.scl",
      "match": "\\b(preset|profile|imports|use)\\b"
    },
    {
      "name": "constant.language.scl",
      "match": "\\b(true|false|null)\\b"
    },
    {
      "name": "constant.numeric.scl",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    {
      "name": "variable.other.scl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_-]*(?=\\s*=)"
    },
    {
      "name": "entity.name.type.scl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_-]*(?=\\s+(?:[A-Za-z_][A-Za-z0-9_-]*\\s+)?\\{)"
    },
    {
      "name": "punctuation.section.scl",
      "match": "[{}\\[\\],=]"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.scl",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.scl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.scl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.scl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.scl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.unquoted.heredoc.scl",
          "begin": "<<-?([A-Za-z_][A-Za-z0-9_]*)\\s*$",
          "end": "^\\s*\\1\\s*$"
        }
      ]
    }
  }
}
